  booktitle   = {ML Reproducibility Challenge 2022 (poster at NeurIPS 2023)},
  year        = {2023},
  abstract    = {We study the reproducibility of "Quantifying Societal Bias Amplification in Image Captioning" by Hirota et al., which proposes the LIC metric for measuring bias amplification. Our reproduced results support all four main claims of the original paper. We also extend the work by evaluating LIC for age bias, finding that only a subset of the models amplifies age bias.},
