@inproceedings{yuksel2024style,
  abbr        = {MIDL},
  title       = {Style Randomization Improves the Robustness of Breast Density Estimation in MR Images},
  author      = {Yüksel, Göksenin and Eppenhof, Koen and Kroes, Jaap and Worring, Marcel},
  booktitle   = {Proceedings of the 7th International Conference on Medical Imaging with Deep Learning (MIDL)},
  series      = {Proceedings of Machine Learning Research},
  volume      = {250},
  pages       = {1841--1850},
  year        = {2024},
  publisher   = {PMLR},
  abstract    = {Breast density, a crucial risk factor for future breast cancer development, is defined by the ratio of fat to fibro-glandular tissue (FGT) in the breast. Accurate breast and FGT segmentation is essential for robust density estimation. We propose a novel data augmentation technique, motivated by style randomization, to further exploit a multi-modal training setup with and without fat suppression. Networks trained with the proposed augmentation are resilient to variations in fat content and show improved robustness compared to training with multi-modal data alone.},
  html        = {https://proceedings.mlr.press/v250/yuksel24a.html},
  pdf         = {https://proceedings.mlr.press/v250/yuksel24a/yuksel24a.pdf},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {reviewed}
}

@inproceedings{baratov2023reproducibility,
  abbr        = {MLRC},
  title       = {Reproducibility Study of "Quantifying Societal Bias Amplification in Image Captioning"},
