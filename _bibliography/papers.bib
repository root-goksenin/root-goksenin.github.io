  title       = {Remining Hard Negatives for Generative Pseudo Labeled Domain Adaptation},
  author      = {Yüksel, Göksenin and Rau, David and Kamps, Jaap},
  journal     = {arXiv preprint arXiv:2501.14434},
  year        = {2025},
  abstract    = {Dense retrievers lose much of their effectiveness when the target domain differs from the training data. This work improves Generative Pseudo Labeling (GPL) domain adaptation by re-mining hard negatives, which strengthens the knowledge distillation signal and improves retrieval performance across several benchmark datasets.},
