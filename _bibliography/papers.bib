  pdf         = {https://arxiv.org/pdf/2501.14434},
  bibtex_show = {true},
  pubgroup    = {preprint}
}

@article{yuksel2025interpretability,
  abbr        = {arXiv},
  title       = {Interpretability Analysis of Domain Adapted Dense Retrievers},
  author      = {Yüksel, Göksenin and Kamps, Jaap},
  journal     = {arXiv preprint arXiv:2501.14459},
  year        = {2025},
  abstract    = {Dense retrievers are not robust across domains, and it is unclear what domain adaptation changes inside them. Using integrated gradients, this work explains how adaptation shifts a retriever's behavior on financial and biomedical datasets: adapted models attend more to domain-specific terms such as "hedge" and "corona", showing how attribution methods can expose the mechanisms behind neural retrieval.},
  html        = {https://arxiv.org/abs/2501.14459},
  pdf         = {https://arxiv.org/pdf/2501.14459},
  bibtex_show = {true},
  pubgroup    = {preprint}
}

@article{yuksel2025correlating,
