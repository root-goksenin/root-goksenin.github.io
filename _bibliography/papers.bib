  title       = {On Correlating Factors for Domain Adaptation Performance},
  author      = {Yüksel, Göksenin and Kamps, Jaap},
  journal     = {arXiv preprint arXiv:2501.14466},
  year        = {2025},
  abstract    = {This work examines which factors explain how well dense retrievers adapt to a new domain. Analyzing the similarity between source and target data, it finds that the distribution of generated query types is an important factor, and that generating queries that match the target domain's query types substantially improves domain adaptation.},
