@inproceedings{yuksel2026audiosphere,
  abbr        = {NeurIPS},
  title       = {AudioSphere: Towards Self-Supervised Spatial Audio Representation Models},
  author      = {Yüksel, Göksenin and van Gerven, Marcel and van der Heijden, Kiki},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS)},
  year        = {2026},
  abstract    = {Recent audio embedding models learn general-purpose representations that transfer across clip- and frame-level tasks, yet they operate almost exclusively on single-channel signals and are blind to spatial structure. We introduce AudioSphere, a multi-channel masked autoencoder trained on Ambisonics recordings that reconstructs both spectral content and directional cues via a joint spatiotemporal masking strategy. Alongside the model, we release RealSELD, a standardized benchmark for evaluating frozen backbones on real-world multi-channel sound event localization and detection (SELD). AudioSphere enables, for the first time, SELD with a frozen self-supervised backbone, while matching or exceeding prior general-purpose audio embedding models on the HEAR benchmark.},
  preview     = {audiosphere.png},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {reviewed}
}

@article{yuksel2026speechjepa,
  abbr        = {Under review},
  title       = {SpeechJEPA: Clustering-Free Latent Prediction for Compute-Efficient Speech Representation Learning},
  author      = {Yüksel, Göksenin and van Gerven, Marcel and van der Heijden, Kiki},
  journal     = {Under review at ICASSP 2027},
  year        = {2026},
  abstract    = {Joint-embedding predictive architectures (JEPAs) were reported to collapse on speech unless anchored by explicit input-level clustering. SpeechJEPA is a clustering-free JEPA that learns speech representations entirely in latent space, without discrete targets, negative samples or auxiliary grounding. A mask-conditioned convolutional predictor regresses several target groups from a single shared context encoding, so the encoder runs once per utterance. Pre-trained on LibriSpeech in 13.8 GPU-hours on one H100, SpeechJEPA beats wav2vec 2.0 with one hour of labels at about 17x fewer training FLOPs, and a 64-GPU-hour model outperforms wav2vec 2.0, HuBERT and WavLM at every labeled-data budget.},
  code        = {https://github.com/labhamlet/SpeechJEPA},
  selected    = {true},
  pubgroup    = {underreview}
}

@article{yuksel2026bearings,
  abbr        = {Under review},
  title       = {Bearings: Self-Supervised Soundfield Embeddings from First-Order Ambisonics},
  author      = {Yüksel, Göksenin and van Gerven, Marcel and van der Heijden, Kiki},
  journal     = {Under review at ICASSP 2027; arXiv:2609.23152},
  year        = {2026},
  abstract    = {Audio encoders capture acoustic content well but have no notion of where sounds come from. Bearings learns spatial audio representations without labels by training a masked autoencoder on first-order Ambisonics, with a decoder conditioned on frozen embeddings from single-channel acoustic encoders. The resulting soundfield embeddings can be combined with different frozen acoustic models without retraining either one. Fused with acoustic representations for sound event localization and detection, they raise the location-dependent F-score from below 4 to 50 on TAU-NIGENS 2021 and to 39 on STARSS23.},
  html        = {https://arxiv.org/abs/2609.23152},
  pdf         = {https://arxiv.org/pdf/2609.23152},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {underreview}
}

@article{yuksel2026equiseld,
  abbr        = {Under review},
  title       = {EquiSELD: Efficient training of equivariant sound event localization and detection networks},
  author      = {Yüksel, Göksenin and van Gerven, Marcel and van der Heijden, Kiki},
  journal     = {Under review at ICASSP 2027; arXiv:2609.23156},
  year        = {2026},
  abstract    = {First-order Ambisonics signals have an exact O(3) symmetry: rotating or reflecting the signal changes the direction of arrival of the sound sources but not the sources themselves. EquiSELD processes Ambisonics as paired streams of O(3)-invariant scalars and equivariant intensity vectors, producing an invariant activity magnitude and an equivariant direction of arrival with a Multi-ACCDOA readout. It outperforms prior equivariant approaches with far fewer parameters and less training time, outperforms non-equivariant SELD networks on simulated scenes, and is competitive on real-world recordings.},
  html        = {https://arxiv.org/abs/2609.23156},
  pdf         = {https://arxiv.org/pdf/2609.23156},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {underreview}
}

@article{yuksel2025wavjepa,
  abbr        = {Under review},
  title       = {WavJEPA: Semantic learning unlocks robust audio foundation models for raw waveforms},
  author      = {Yüksel, Göksenin and Guetschel, Pierre and Tangermann, Michael and van Gerven, Marcel and van der Heijden, Kiki},
  journal     = {Under review at IEEE/ACM Transactions on Audio, Speech, and Language Processing; arXiv:2509.23238},
  year        = {2025},
  abstract    = {Learning audio representations from raw waveforms overcomes key limitations of spectrogram-based audio representation learning, such as the latency of spectrogram computation and the loss of phase information. We propose WavJEPA, a waveform-based version of the Joint-Embedding Predictive Architecture that learns high-level semantic representations, substantially outperforming state-of-the-art time-domain audio foundation models while requiring considerably fewer computational resources. We also present WavJEPA-Nat, a multi-channel extension trained on simulated naturalistic scenes that is highly robust to reverberation and noise.},
  html        = {https://arxiv.org/abs/2509.23238},
  pdf         = {https://arxiv.org/pdf/2509.23238},
  code        = {https://github.com/labhamlet/wavjepa},
  website     = {https://huggingface.co/labhamlet/wavjepa-nat-base},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {underreview}
}

@article{yuksel2025gram,
  abbr        = {arXiv},
  title       = {GRAM: Spatial general-purpose audio representations},
  author      = {Yüksel, Göksenin and van Gerven, Marcel and van der Heijden, Kiki},
  journal     = {arXiv preprint arXiv:2506.00934},
  year        = {2025},
  abstract    = {Most audio foundation models ignore the spatial structure of real-world sound scenes. We propose GRAM, a general-purpose real-world audio model that uses a multi-channel masked autoencoder to efficiently learn spatial audio representations. We evaluate GRAM and other audio foundation models on high-quality simulations of naturalistic spatial acoustic environments and on real-world recordings, and release two complementary benchmark task suites: NatHEAR and RealSELD.},
  html        = {https://arxiv.org/abs/2506.00934},
  pdf         = {https://arxiv.org/pdf/2506.00934},
  code        = {https://github.com/labhamlet},
  bibtex_show = {true},
  selected    = {true},
  pubgroup    = {preprint}
}

